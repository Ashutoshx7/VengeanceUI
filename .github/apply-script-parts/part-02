async function appendRegistryEntry(relativePath) {
  const path = join(repoRoot, relativePath);
  const content = await readFile(path, "utf8");
  if (content.includes('"name": "mega-menu-navbar"')) return;

  const closingIndex = content.lastIndexOf("\n]");
  if (closingIndex === -1) throw new Error(`Could not find closing array in ${relativePath}`);

  const before = content.slice(0, closingIndex).trimEnd();
  const separator = before.endsWith("[") ? "\n" : ",\n";
  await writeFile(path, `${before}${separator}${registryEntry}\n]\n`, "utf8");
}

