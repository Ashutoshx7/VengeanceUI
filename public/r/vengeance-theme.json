{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "vengeance-theme",
  "type": "registry:theme",
  "title": "VengeanceUI theme tokens",
  "description": "Editable colors, radii, spacing, and transition speed for VengeanceUI components.",
  "cssVars": {
    "theme": {
      "color-vng-primary": "var(--vng-primary)",
      "color-vng-secondary": "var(--vng-secondary)",
      "color-vng-danger": "var(--vng-danger)",
      "color-vng-success": "var(--vng-success)",
      "color-vng-warning": "var(--vng-warning)",
      "radius-sm": "var(--vng-radius-sm)",
      "radius-md": "var(--vng-radius-md)",
      "radius-lg": "var(--vng-radius-lg)"
    },
    "light": {
      "vng-background": "#ffffff",
      "vng-foreground": "#09090b",
      "vng-border": "#e4e4e7",
      "vng-primary": "#09090b",
      "vng-primary-hover": "#27272a",
      "vng-primary-foreground": "#ffffff",
      "vng-secondary": "#f4f4f5",
      "vng-secondary-foreground": "#09090b",
      "vng-danger": "#dc2626",
      "vng-success": "#16a34a",
      "vng-warning": "#eab308",
      "vng-radius-sm": "4px",
      "vng-radius-md": "6px",
      "vng-radius-lg": "8px",
      "vng-space-xs": "0.5rem",
      "vng-space-sm": "0.75rem",
      "vng-space-md": "1rem",
      "vng-space-lg": "2rem",
      "vng-transition-speed": "150ms",
      "vng-transition-speed-slow": "calc(var(--vng-transition-speed) * 2)",
      "background": "var(--vng-background)",
      "foreground": "var(--vng-foreground)",
      "border": "var(--vng-border)",
      "primary": "var(--vng-primary)",
      "primary-foreground": "var(--vng-primary-foreground)",
      "secondary": "var(--vng-secondary)",
      "secondary-foreground": "var(--vng-secondary-foreground)",
      "destructive": "var(--vng-danger)",
      "ring": "var(--vng-primary)",
      "radius": "var(--vng-radius-lg)"
    },
    "dark": {
      "vng-background": "#09090b",
      "vng-foreground": "#ffffff",
      "vng-border": "#27272a",
      "vng-primary": "#ffffff",
      "vng-primary-hover": "#e4e4e7",
      "vng-primary-foreground": "#09090b",
      "vng-secondary": "#27272a",
      "vng-secondary-foreground": "#ffffff",
      "background": "var(--vng-background)",
      "foreground": "var(--vng-foreground)",
      "border": "var(--vng-border)",
      "primary": "var(--vng-primary)",
      "primary-foreground": "var(--vng-primary-foreground)",
      "secondary": "var(--vng-secondary)",
      "secondary-foreground": "var(--vng-secondary-foreground)",
      "destructive": "var(--vng-danger)",
      "ring": "var(--vng-primary)"
    }
  }
}
